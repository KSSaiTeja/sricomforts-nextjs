# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files — keep .env.example commitable as the template
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / local agent caches (not shared)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.agents/
skills-lock.json

# Cursor project rules + settings ARE tracked (desktop / other machines).
# Only ignore local Cursor junk if it appears later.
.cursor/*.log

# graphify knowledge graph — live artifacts are tracked so agents keep context
# across machines. Cache, dated snapshots, and machine-local paths stay local.
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-*/
graphify-out/.graphify_root
graphify-out/.graphify_python
graphify-out/.vocab.txt
graphify-out/.graphify_old.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_incremental.json
graphify-out/.graphify_detect.json
graphify-out/.graphify_transcripts.json

# Local-only folders (not part of the site)
terminal-industries-clone/
website-refs/
/assets/
/scripts/

# Temp imports / staging
.tmp/
.tmp-*/

# OS / tooling noise
.turbo/
*.swp
*.swo
*.ses
*~
